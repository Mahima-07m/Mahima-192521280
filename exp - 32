from Crypto.PublicKey import DSA
from Crypto.Signature import DSS
from Crypto.Hash import SHA256

# Generate DSA key pair
key = DSA.generate(2048)
public_key = key.publickey()

message = input("Enter Message: ").encode()

# Hash the message
h1 = SHA256.new(message)
h2 = SHA256.new(message)

# Sign the same message twice
signer = DSS.new(key, 'fips-186-3')

signature1 = signer.sign(h1)
signature2 = signer.sign(h2)

print("Signature 1:", signature1.hex())
print("Signature 2:", signature2.hex())

# Verify first signature
verifier = DSS.new(public_key, 'fips-186-3')

try:
    verifier.verify(SHA256.new(message), signature1)
    print("Signature 1 Verified")
except ValueError:
    print("Signature 1 Invalid")
