from math import gcd

text = input("Enter Plaintext: ").upper()

a = int(input("Enter value of a: "))
b = int(input("Enter value of b: "))

if gcd(a, 26) != 1:
    print("Invalid value of a")
else:
    cipher = ""

    for ch in text:
        if ch.isalpha():
            p = ord(ch) - 65
            c = (a * p + b) % 26
            cipher += chr(c + 65)
        else:
            cipher += ch

    print("Ciphertext:", cipher)
