# CMAC Subkey Generation (Simplified)

block_size = int(input("Enter block size (64 or 128): "))

if block_size == 64:
    Rb = 0x1B
elif block_size == 128:
    Rb = 0x87
else:
    print("Invalid block size")
    exit()

L = 0  # Block of all 0 bits

def generate_subkey(value):
    msb = (value >> (block_size - 1)) & 1
    value = (value << 1) & ((1 << block_size) - 1)

    if msb:
        value ^= Rb

    return value

K1 = generate_subkey(L)
K2 = generate_subkey(K1)

print("K1 =", hex(K1))
print("K2 =", hex(K2))
