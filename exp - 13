# Hill Cipher (2x2)

key = [[9, 4], [5, 7]]

text = input("Enter plaintext: ").lower().replace(" ", "")

if len(text) % 2 != 0:
    text += "x"

cipher = ""

for i in range(0, len(text), 2):
    p1 = ord(text[i]) - 97
    p2 = ord(text[i + 1]) - 97

    c1 = (key[0][0] * p1 + key[0][1] * p2) % 26
    c2 = (key[1][0] * p1 + key[1][1] * p2) % 26

    cipher += chr(c1 + 97)
    cipher += chr(c2 + 97)

print("Plaintext :", text)
print("Ciphertext:", cipher)
print("\nKnown Plaintext Pair")
print(text, "->", cipher)
